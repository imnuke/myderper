# Copy to .env and fill in real values:
#   cp example.env .env

# Address clients use to reach this DERP server (goes into the derpMap's
# HostName field). The cert's CN/SAN use this value too, but only as
# metadata — clients verify by SHA256 pinning.
DOMAIN=<Domain Name>

# Tailscale auth key for the sidecar tailscaled. derper uses its socket
# for --verify-clients, and the same node also acts as a peer relay.
# Create at https://login.tailscale.com/admin/settings/keys with
# `tag:relay` pre-authorized (the node advertises that tag).
TS_AUTHKEY=<Tailscale Auth Key>

# UDP port the peer relay listens on (must be reachable from peers).
# Only sets the host port mapping here; the value must also be applied
# inside tailscaled via `tailscale set --relay-server-port=N` once
# after first boot. See README "Peer relay".
PEER_RELAY_PORT=40000

# Optional version pins.
TAILSCALE_VERSION=v1.96.5
DERPER_VERSION=v1.96.5
